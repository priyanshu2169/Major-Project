<%- layout("/layouts/boilerplate") %>
<body>
    <h3>Edit this listing :</h3>
    <form method="POST" action="/listings/<%=listings._id %>?_method=PUT">
        <input name="listing[title]" placeholder="enter title" type="text" value="<%=listings.title %>">
        <br><br>
        <textarea name="listing[description]" placeholder="enter description" type="text"><%=listings.description %></textarea>
        <br><br>
        <input name="listing[price]" placeholder="enter price" type="number" value="<%=listings.price %>">
        <br><br>
        <input name="listing[location]" placeholder="enter location" type="text" value="<%=listings.location %>">
        <br><br>
        <input name="listing[country]" placeholder="enter country" type="text" value="<%=listings.country %>">
        <br><br>
        <button>EDIT</button>
    </form>
</body>
